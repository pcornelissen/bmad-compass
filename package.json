{
  "name": "bmad-compass",
  "version": "0.5.0",
  "description": "Local web dashboard that visualizes BMAD-Method project progress alongside Claude Code.",
  "keywords": [
    "bmad",
    "bmad-method",
    "dashboard",
    "claude-code",
    "ai-coding",
    "workflow"
  ],
  "type": "module",
  "bin": {
    "bmad-compass": "./bin/bmad-compass.js"
  },
  "main": "dist/server/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Patrick Cornelißen <patrick.cornelissen@atvantage.com>",
  "license": "MIT",
  "homepage": "https://github.com/pcornelissen/bmad-compass#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pcornelissen/bmad-compass.git"
  },
  "bugs": {
    "url": "https://github.com/pcornelissen/bmad-compass/issues"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -n SRV,WEB -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:client && pnpm build:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "csv-parse": "^6.2.1",
    "express": "^4.19.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "open": "^10.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "happy-dom": "^13.0.0",
    "memfs": "^4.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "supertest": "^6.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0",
    "zustand": "^4.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
